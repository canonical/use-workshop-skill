#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-only
# Copyright 2026 Canonical Ltd.
#
# check-health: runs inside the workshop to report SDK health. Verify the
# tool(s) this SDK sets up actually resolve, then report via workshopctl.
#
# This file must be executable: chmod +x .workshop/<sdk-name>/hooks/check-health

set -eu

if command -v <tool-to-verify> >/dev/null 2>&1; then
    workshopctl set-health okay
else
    workshopctl set-health error "<tool-to-verify> not found on PATH"
fi
