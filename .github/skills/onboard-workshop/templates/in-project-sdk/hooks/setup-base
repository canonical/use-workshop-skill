# setup-base: runs as root when the SDK is installed into the base (before the
# project is mounted). Re-runs only when the base or SDK revision changes —
# an applied refresh does NOT re-run it; recreate the workshop to apply edits.
# Source the package list from the repo's own evidence (CI workflow apt-get
# lines, Dockerfile, README) — or, for Electron/Chromium test hosts, the
# canonical library set in references/toolchain-signals.md. Do not guess.
#
# chmod +x is house style (keeps the file runnable by hand) — Workshop runs
# hooks with bash regardless, so a 0644 hook still executes. The interpreter
# is always bash with errexit+pipefail, whatever the shebang says.

set -euo pipefail

apt-get update
apt-get install -y \
  <packages-from-repo-evidence>
