set -euo pipefail

version() {
  dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  if [[ -f "${dir}/VERSION" ]]; then
    cat "${dir}/VERSION"
  else
    echo "unknown"
  fi
}

case "${1:-}" in
  --version) version ;;
  *) echo "Hello, ${1:-world}!" ;;
esac
